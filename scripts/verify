#!/usr/bin/env bash
set -euo pipefail
repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
formatter=${REVOFMT_BIN:-$(command -v revofmt || true)}
if [[ ! -x "$formatter" ]]; then
  printf 'Set REVOFMT_BIN to a real formatter executable.\n' >&2
  exit 1
fi
export REVOFMT_BIN
REVOFMT_BIN=$(realpath -- "$formatter")
test_directory=$(mktemp -d)
trap 'rm -rf -- "$test_directory"' EXIT
export XDG_CONFIG_HOME="$test_directory/config" XDG_DATA_HOME="$test_directory/data"
export XDG_STATE_HOME="$test_directory/state" XDG_CACHE_HOME="$test_directory/cache"
cd -- "$repo_root"
nvim --headless -u NONE -i NONE -n -l tests/run.lua
nvim --headless -u NONE -i NONE -n -l tests/install.lua
